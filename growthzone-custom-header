<!-- ============================ 3. SCRIPT ============================ -->
<script>
(function () {
    'use strict';

    var headerToggle = document.querySelector('.pw-header__toggle');
    var headerNav = document.querySelector('.pw-header__nav');
    if (!headerToggle || !headerNav) return;

    headerToggle.addEventListener('click', function () {
        var open = headerNav.classList.toggle('is-open');
        headerToggle.classList.toggle('is-active', open);
        headerToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    });

    document.addEventListener('click', function (e) {
        if (!headerToggle.contains(e.target) && !headerNav.contains(e.target)) {
            headerNav.classList.remove('is-open');
            headerToggle.classList.remove('is-active');
            headerToggle.setAttribute('aria-expanded', 'false');
        }
    });

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
            headerNav.classList.remove('is-open');
            headerToggle.classList.remove('is-active');
            headerToggle.setAttribute('aria-expanded', 'false');
        }
    });

    // Mobile sub-menu accordion. The toggle buttons are already in the markup
    // here, so we only bind them; the parent link keeps navigating normally.
    var navParents = headerNav.querySelectorAll('.menu-item-has-children');
    Array.prototype.forEach.call(navParents, function (item) {
        var toggle = item.querySelector(':scope > .pw-header__submenu-toggle');
        if (!toggle) return;

        toggle.addEventListener('click', function () {
            var isOpen = item.classList.contains('is-open');
            Array.prototype.forEach.call(navParents, function (sib) {
                sib.classList.remove('is-open');
            });
            if (!isOpen) {
                item.classList.add('is-open');
            }
        });
    });

    // Highlight the menu item for the current page. The markup is hard-coded
    // and shared across pages, so match the page URL against each link
    // (longest match wins; e.g. /events/details/... -> Events).
    var normalize = function (url) {
        var a = document.createElement('a');
        a.href = url;
        return (a.hostname.replace(/^www\./, '') + a.pathname.replace(/\/+$/, '')).toLowerCase();
    };
    var here = normalize(window.location.href);
    var best = null;
    var bestLen = 0;
    Array.prototype.forEach.call(headerNav.querySelectorAll('.menu a[href]'), function (link) {
        var href = link.getAttribute('href');
        if (!href || href.charAt(0) === '#') return;
        var target = normalize(link.href);
        var isRoot = target.indexOf('/') === -1;
        var match = here === target || (!isRoot && here.indexOf(target + '/') === 0);
        if (match && target.length > bestLen) {
            best = link;
            bestLen = target.length;
        }
    });
    if (best) {
        Array.prototype.forEach.call(headerNav.querySelectorAll('.current-menu-item, .current-menu-ancestor'), function (li) {
            li.classList.remove('current-menu-item', 'current-menu-ancestor');
        });
        var li = best.closest('li');
        li.classList.add('current-menu-item');
        best.setAttribute('aria-current', 'page');
        var parent = li.parentElement.closest('li');
        while (parent) {
            parent.classList.add('current-menu-ancestor');
            parent = parent.parentElement.closest('li');
        }
    }
})();
</script>
